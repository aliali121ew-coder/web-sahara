{
  "name": "sahara-fuel-karbala-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build": "node scripts/i18n-check.mjs && eslint src && tsc && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build:staging": "node scripts/i18n-check.mjs && eslint src && tsc && vite build --mode staging",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "lint:i18n": "eslint src",
    "test": "vitest run",
    "spell": "cspell --no-progress \"src/i18n/locales/en/*.json\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-resources-to-backend": "^1.2.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cspell": "^10.3.6",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.140.0"
  }
}
