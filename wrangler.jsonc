{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etihad-company",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // قاعدة بيانات حفظ بيانات التطبيق (تُنشأ تلقائيًا عند أول رفع)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "etihad-company-data"
    }
  ]
}
