{
  "$schema": "node_modules/wrangler/config-schema.json",
  // يطابق اسم مشروع Workers في لوحة Cloudflare (أمر المعاينة wrangler preview يستهدف هذا الاسم)
  "name": "sahara-fuel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // قاعدة بيانات حفظ بيانات التطبيق (تُنشأ تلقائيًا عند أول رفع)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "etihad-company-data"
    }
  ],
  // R2: الملفات (مرفقات الصحاري والمحادثة) في حاوية، والنسخ الاحتياطية والأرشيف في حاوية منفصلة
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "etihad-files" },
    { "binding": "BACKUPS", "bucket_name": "etihad-backups" }
  ],
  // قناة التحديث اللحظي (WebSocket): كائن واحد يبلّغ كل الأجهزة المفتوحة عند أي حفظ
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "StateHub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StateHub"] }
  ],
  // نسخة احتياطية يومية 00:00 UTC (03:00 بتوقيت العراق)، والصيانة الشهرية تُشغَّل من نفس المهمة في أول كل شهر
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  // بيئة التجربة: Worker وقاعدة D1 وحاويات R2 منفصلة تمامًا عن التشغيل الفعلي
  // النشر: npx wrangler deploy --env staging   (الروابط لا تُورَث بين البيئات فتُعرَّف هنا كاملة)
  "env": {
    "staging": {
      "name": "etihad-company-staging",
      "d1_databases": [
        { "binding": "DB", "database_name": "etihad-company-data-staging" }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "etihad-files-staging" },
        { "binding": "BACKUPS", "bucket_name": "etihad-backups-staging" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "HUB", "class_name": "StateHub" }]
      },
      // بلا مهام مجدولة في التجربة (تُشغَّل يدويًا من لوحة إدارة النظام عند الحاجة)
      "triggers": { "crons": [] }
    },
    // النسخة التجريبية للزوار (رابط workers.dev المجاني): قاعدة D1 وحاويات R2 وقناة تحديث خاصة بها،
    // فلا طريق منها إلى بيانات التشغيل الفعلي. حسابات بمدة (ساعة إلى شهر) يُنشئها مديرها،
    // والبيانات تُعاد كل ليلة إلى "البيانات الأساسية" (worker/demo.ts).
    // النشر: npm run deploy:demo (يبني بـ vite --mode demo فيختار إضافة Cloudflare هذه البيئة؛ wrangler deploy --env وحده لا يكفي)
    // ويحتاج مرة واحدة: npx wrangler secret put APP_TOKEN --env demo
    "demo": {
      "name": "sahara-demo",
      "workers_dev": true,
      "vars": { "DEMO_MODE": "1" },
      "d1_databases": [
        { "binding": "DB", "database_name": "sahara-demo-data" }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "sahara-demo-files" },
        { "binding": "BACKUPS", "bucket_name": "sahara-demo-backups" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "HUB", "class_name": "StateHub" }]
      },
      // إعادة البيانات الوهمية وإيقاف الحسابات المنتهية: 00:00 UTC (03:00 بتوقيت العراق)
      "triggers": { "crons": ["0 0 * * *"] }
    }
  }
}
